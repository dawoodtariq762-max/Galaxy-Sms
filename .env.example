# Power X SMS — environment configuration
# Copy this file to .env on your VPS and fill in real values.

NODE_ENV=production
PORT=4000

# REQUIRED in production. Use a long random string.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# Database file location.
# Leave commented to use the default: backend/data.sqlite
# DB_FILE=/root/PowerX-SMS/backend/data.sqlite

# Alternative to DB_FILE — data.sqlite is placed inside this folder.
# DATA_DIR=/root/powerx-data

# Automatic backups. Keep them OUTSIDE the app folder so git pull never touches them.
BACKUP_ENABLED=true
BACKUP_DIR=/root/powerx-sms-backups
BACKUP_INTERVAL_HOURS=3
BACKUP_RETENTION_DAYS=30

# Provider sync scheduler (API Providers screen).
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=12
