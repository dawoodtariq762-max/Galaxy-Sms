# Galaxy SMS — environment configuration (COPY karke .env banao aur values bharo)
# VPS path: /opt/galaxy/.env  (ye file .gitignore me hai — kabhi commit nahi hoti)
# Baad me: pm2 restart galaxy
# NOTE: .env.example me HAMESHA placeholders rakhna — real secrets yahan nahi.

# ---- P19i: Gmail SMTP (public panel requests + OTP emails) ----
# Google Account (apna Galaxy Gmail) par:
#   1) 2-Step Verification ON karo: https://myaccount.google.com/security
#   2) App Password banao (16-char): https://myaccount.google.com/apppasswords
#      (App Password sirf 2-Step Verification ON hone par dikhta hai)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourgalaxyaccount@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx        # 16-char App Password (spaces ke bina paste karo)
# MAIL_FROM="Galaxy SMS" <yourgalaxyaccount@gmail.com>   # optional (default: SMTP_USER)

# ---- Panel request settings (optional — defaults theek hain) ----
# OTP_TTL_MINUTES=10                    # OTP expiry (default 10)
# OTP_RESEND_GAP_MS=60000               # do OTP ke beech min gap (default 60s)
# OTP_MAX_PER_HOUR=3                    # per email max OTP/hour (default 3)
# PASSWORD_SETUP_TTL_MINUTES=1440       # setup link validity (default 24h)
# PUBREQ_ENABLED=1                      # 0 = public form band
# PUBLIC_BASE_URL=http://YOUR.VPS.IP    # emails me panel URL ke liye (recommended set karo)
